{
  "name": "my-daily-path",
  "version": "0.1.0",
  "private": true,
  "description": "My Daily Path - personal AI assistant for life, learning and career",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "mobile:url": "powershell -ExecutionPolicy Bypass -File scripts/show-mobile-url.ps1",
    "dev:open": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -OpenApp",
    "dev:server": "powershell -ExecutionPolicy Bypass -File scripts/run-dev-server.ps1",
    "app:open": "powershell -ExecutionPolicy Bypass -Command \"Start-Process (Join-Path (Get-Location) 'MyDailyPath.exe')\"",
    "app:install": "powershell -ExecutionPolicy Bypass -File scripts/install-windows-app.ps1",
    "app:icon": "powershell -ExecutionPolicy Bypass -File scripts/generate-app-icon.ps1",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/clean-dev-cache.ps1 -KillPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "autostart:install": "powershell -ExecutionPolicy Bypass -File scripts/register-windows-autostart.ps1",
    "autostart:test": "powershell -ExecutionPolicy Bypass -File scripts/test-autostart.ps1",
    "autostart:remove": "powershell -ExecutionPolicy Bypass -File scripts/unregister-windows-autostart.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src",
    "sync:restore": "node scripts/sync-restore.mjs",
    "sync:restore:full": "npx vercel env pull .env.vercel.local --environment=production --yes && node scripts/sync-restore.mjs",
    "sync:env": "node scripts/merge-sync-env.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
